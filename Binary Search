class Solution:
    def search(self, nums: List[int], target: int) -> int:
        
        low = 0
        high = len(nums) - 1
      
        while low <= high:
            midd = (low + high)//2

            if nums[midd] == target:
                return midd

            elif nums[midd] < target:
                low = midd + 1

            else:
                high = midd - 1

        return -1        
