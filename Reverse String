class Solution:
    def reverseString(self, s: List[str]) -> None:
        """
        Do not return anything, modify s in-place instead.
        """
        return self.recursion(s,start = 0,end = len(s)-1)

    def recursion(self,s,start,end):
        if start>=end: return 
        s[start],s[end] = s[end],s[start]
        return self.recursion(s,start+1,end-1)
        
  
      
